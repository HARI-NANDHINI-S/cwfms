# Disable PHP execution in uploads directory
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Block all script extensions
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|cgi|pl|py|sh|bash|exe)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Only allow legitimate media / document types
<FilesMatch "\.(pdf|ai|eps|png|jpg|jpeg|zip|xlsx|xls|csv)$">
    Order allow,deny
    Allow from all
</FilesMatch>
