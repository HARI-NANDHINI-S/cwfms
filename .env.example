# ==============================================================================
# Ira Sportswear CWFMS - Local Environment Configuration (.env)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' in the project root:
#      copy .env.example .env
# 2. Fill in your existing Supabase project credentials below.
# 3. Save the file. The dashboard will automatically detect it and show 'DB Live'.
#
# NOTE: The .env file is strictly excluded by .gitignore and must NEVER be
# committed to Git or pushed to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# Retrieve from: Supabase Dashboard -> Project Settings (gear icon) -> API
#
# 1. Project URL:
#    Format: https://<project-ref>.supabase.co
SUPABASE_URL=https://<your-project-ref>.supabase.co

# 2. Project Reference ID:
#    Found under Project Settings -> General -> Reference ID
SUPABASE_PROJECT_REF=<your-project-ref>

# 3. Anon (Public) Key:
#    Found under Project Settings -> API -> Project API Keys -> 'anon' / 'public'
SUPABASE_ANON_KEY=<your-anon-key>

# 4. Service Role (Secret) Key:
#    Found under Project Settings -> API -> Project API Keys -> 'service_role' / 'secret'
#    Used exclusively by PHP server-side backend for secure API operations.
#    NEVER expose this key to browser client scripts.
SUPABASE_SERVICE_KEY=<your-service-role-key>

# 5. Database Password (Optional - only required for direct pg_dump / psql CLI):
SUPABASE_DB_PASSWORD=<your-database-password>

# ------------------------------------------------------------------------------
# APPLICATION MODE
# ------------------------------------------------------------------------------
# Options: 'development' | 'production'
APP_ENV=development

# ------------------------------------------------------------------------------
# WHATSAPP CLOUD API CONFIGURATION (OPTIONAL / PRODUCTION)
# ------------------------------------------------------------------------------
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TOKEN=<your-meta-whatsapp-token>
WHATSAPP_PHONE_NUMBER_ID=<your-phone-number-id>
WHATSAPP_BUSINESS_ACCOUNT_ID=<your-business-account-id>
WHATSAPP_WEBHOOK_VERIFY_TOKEN=ira_sportswear_wh_verify_secret_token_2026
WHATSAPP_APP_SECRET=<your-meta-app-secret>
WHATSAPP_AUTOMATIONS_ENABLED=1
WHATSAPP_AUTOMATION_STAGES=Received,Awaiting Clarification,Approved,Moved to Production
